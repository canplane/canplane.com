---
import PostCardColumn from "./PostCardColumn.astro";
import type { Post } from "../utils/posts";

interface Props {
  tabTitle: string;
  posts: Post[];
}
const { tabTitle, posts } = Astro.props;
---

<div class="grid w-full">
  <div class="grid-1 flex flex-col items-start">
    <div class="flex h-20 flex-col justify-center">
      <p class="w-fit text-[2.25rem]">{tabTitle}</p>
    </div>
  </div>
  <PostCardColumn posts={posts} />
</div>
