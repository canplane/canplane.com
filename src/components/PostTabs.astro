---
import PostCardColumn from "./PostCardColumn.astro";
import type { Post } from "../utils/posts";

interface Props {
  tabTitle: string;
  posts: Post[];
}
const { tabTitle, posts } = Astro.props;
---

<div class="post-tabs-wrapper grid">
  <div class="post-tabs grid-1">
    <div class="category-page-header-wrapper">
      <p class="category-page-title">{tabTitle}</p>
    </div>
  </div>
  <PostCardColumn posts={posts} />
</div>

<style lang="scss">
  .post-tabs-wrapper {
    width: 100%;

    .post-tabs {
      display: flex;
      flex-direction: column;
      align-items: flex-start;

      .category-page-header-wrapper {
        height: 5rem;

        display: flex;
        flex-direction: column;
        justify-content: center;

        .category-page-title {
          width: fit-content;
          font-size: 2.25rem;
        }
      }
    }
  }
</style>
