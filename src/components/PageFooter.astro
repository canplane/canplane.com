---
interface Props {
  author: string;
  githubUrl: string;
}
const { author, githubUrl } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="absolute inset-x-0 bottom-0 flex h-20 items-end p-6">
  <a href={githubUrl}>
    <p class="text-sm leading-[1.625] text-secondary-text">© {year} {author}</p>
  </a>
</footer>
