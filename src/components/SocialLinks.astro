---
import GitHubIcon from "./icons/GitHubIcon.astro";
import { Mail } from "@lucide/astro";

interface Props {
  links?: Record<string, string | undefined>;
  large?: boolean;
}

const { links = {}, large = false } = Astro.props;
const entries = Object.entries(links).filter(([, value]) => Boolean(value));
const size = large ? "h-[30px] w-[30px]" : "h-5 w-5";
const githubClass = `fill-secondary-text ${size}`;
const emailClass = `stroke-secondary-text ${size}`;
---

{entries.map(([key, value]) => (
  <a
    class="inline-flex items-center justify-center p-2 hover:opacity-70"
    title={key}
    href={key === "email" ? `mailto:${value}` : value}
    target={key === "email" ? undefined : "_blank"}
    rel={key === "email" ? undefined : "noopener noreferrer"}
  >
    {key === "github" && <GitHubIcon class={githubClass} />}
    {key === "email" && <Mail class={emailClass} stroke-width={1} />}
  </a>
))}
