---
import SocialLinks from "./SocialLinks.astro";

interface Props {
  bio: { name: string; description: string };
  social: Record<string, string | undefined>;
}
const { bio, social } = Astro.props;
const [descriptionStart, descriptionEnd] = bio.description.split(/\s+and\s+/);
---

<div class="absolute inset-0 flex items-center justify-center px-6 pb-[5%] lg:px-12">
  <div class="grid grid-cols-[auto] justify-center gap-0 lg:grid-cols-[auto_auto] lg:gap-x-20">
    <img
      class="block w-60"
      alt="logo"
      src="/brand/logo.svg"
    />
    <div class="flex flex-col justify-center break-keep text-5xl leading-tight">
      <p>
        Hello,<br />
        I'm {bio.name}.<br />
      </p>
      <p class="mt-4 text-2xl">
        {descriptionStart}<br />
        {descriptionEnd && <>and {descriptionEnd}<br /></>}
      </p>
      <div class="-ml-1.25 mt-6 flex gap-2">
        <SocialLinks links={social} />
      </div>
    </div>
  </div>
</div>
