---
import IconButtonBar from "./IconButtonBar.astro";

interface Props {
  bio: { name: string; description: string };
  social: Record<string, string | undefined>;
}
const { bio, social } = Astro.props;
---

<div class="absolute inset-0 flex items-center justify-center pb-[5%]">
  <div class="grid grid-cols-[auto] justify-center gap-0 lg:grid-cols-[auto_auto] lg:gap-x-20">
    <img
      class="block w-60 dark:grayscale"
      alt="logo"
      src="/brand/author-symbol.svg"
    />
    <div class="flex flex-col justify-center break-keep text-[3rem] leading-[1.25]">
      <p>
        Hello,<br />
        My name is<br />
        {bio.name}.<br />
      </p>
      <p class="mt-4 text-2xl">
        {bio.description}<br />
      </p>
      <div class="-ml-[5px] mt-6 flex">
        <IconButtonBar links={social} large />
      </div>
    </div>
  </div>
</div>
