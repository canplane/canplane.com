---
import { formatDate } from "../utils/posts";
import type { Post } from "../utils/posts";

interface Props {
  post: Post;
}
const { post } = Astro.props;
const href = `/${post.slug}/`;
---

<a
  class="flex h-20 w-full cursor-pointer items-center border-b-[3px] border-border text-inherit"
  href={href}
>
  <div class="flex w-full items-center justify-between">
    <div class="min-w-0 overflow-hidden text-ellipsis whitespace-nowrap text-2xl text-primary-text">
      {post.data.title}
    </div>
    <div class="ml-4 shrink-0">
      <div class="text-base text-secondary-text">{formatDate(post.data.date)}</div>
    </div>
  </div>
</a>
