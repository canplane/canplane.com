---
import { Search, Menu, X } from "@lucide/astro";
import { getAllPosts, getUniqueCategories } from "@/utils/posts";
import { SITE } from "@/utils/site";

const posts = await getAllPosts();
const categories = ["All", ...getUniqueCategories(posts)];
const searchIndex = posts.map((p) => ({ title: p.data.title, slug: `/${p.slug}/` }));
---

<header
  class="fixed inset-x-0 top-0 z-10 flex p-4 pointer-events-none transition-[top] duration-300 ease-in-out data-[hidden=true]:-top-20"
  id="page-header"
>
  <div class="pointer-events-auto flex h-12 w-full items-center">
    <div class="flex">
      <button
        class="rounded-none border-none bg-none hover:opacity-70"
        type="button"
        onclick="location.href='/'"
      >
        <img class="block h-12 w-12" src="/brand/logo.svg" alt={SITE.title} />
      </button>
    </div>
    <div class="ml-auto! flex gap-2">
      <button
        class="flex h-12 w-12 items-center justify-center rounded-none border-none bg-none hover:opacity-70 [&_svg]:h-7 [&_svg]:w-7 [&_svg]:stroke-primary-text"
        type="button"
        id="open-search"
        aria-label="Search"
      >
        <Search stroke-width={1} />
      </button>
      <button
        class="flex h-12 w-12 items-center justify-center rounded-none border-none bg-none hover:opacity-70 [&_svg]:h-7 [&_svg]:w-7 [&_svg]:stroke-primary-text"
        type="button"
        id="open-nav"
        aria-label="Menu"
      >
        <Menu stroke-width={1} />
      </button>
    </div>
  </div>
</header>

<div
  class="group fixed inset-0 z-20 pointer-events-none opacity-0 transition-opacity duration-300 pt-20 data-[open=true]:pointer-events-auto data-[open=true]:opacity-100 data-[open=true]:bg-float-background data-[open=true]:backdrop-blur-lg"
  id="menu-search"
  data-open="false"
>
  <button
    class="absolute top-4 right-4 z-1 rounded-none border-none bg-none hover:opacity-70"
    type="button"
    id="close-search"
    aria-label="Close"
  >
    <div class="flex h-12 w-12 items-center justify-center [&_svg]:h-7 [&_svg]:w-7 [&_svg]:stroke-primary-text">
      <X stroke-width={1} />
    </div>
  </button>
  <div class="absolute inset-x-6 top-20 bottom-0 lg:inset-x-1/4">
    <div class="relative flex h-16 items-center justify-center border-b-2 border-primary-text">
      <div class="absolute left-0 h-full w-auto mr-3 flex items-center justify-center [&_svg]:h-7 [&_svg]:w-7 [&_svg]:stroke-primary-text">
        <Search stroke-width={1} />
      </div>
      <input
        class="h-full w-[calc(100%-3rem-2rem)] bg-none text-center text-2xl text-primary-text outline-none"
        id="search-input"
        type="text"
        autocomplete="off"
      />
    </div>
    <div class="flex flex-col pt-8" id="auto-complete-list"></div>
  </div>
</div>

<div
  class="group fixed inset-0 z-20 pointer-events-none opacity-0 transition-opacity duration-300 pt-20 data-[open=true]:pointer-events-auto data-[open=true]:opacity-100 data-[open=true]:bg-float-background data-[open=true]:backdrop-blur-lg"
  id="menu-nav"
  data-open="false"
>
  <button
    class="absolute top-4 right-4 z-1 rounded-none border-none bg-none hover:opacity-70"
    type="button"
    id="close-nav"
    aria-label="Close"
  >
    <div class="flex h-12 w-12 items-center justify-center [&_svg]:h-7 [&_svg]:w-7 [&_svg]:stroke-primary-text">
      <X stroke-width={1} />
    </div>
  </button>
  <div class="absolute inset-x-6 top-20 bottom-0 lg:inset-x-1/4">
    <div class="flex flex-col">
      {categories.map((category, idx) => (
        <a
          class="flex h-16 items-center text-primary-text hover:underline underline-offset-4 [&_p]:w-full [&_p]:text-center [&_p]:text-2xl"
          href={idx === 0 ? "/posts" : `/posts/${category}`}
        >
          <p>{category}</p>
        </a>
      ))}
      <a
        class="flex h-16 items-center text-primary-text hover:underline underline-offset-4 [&_p]:w-full [&_p]:text-center [&_p]:text-2xl"
        href="/about"
      >
        <p>About</p>
      </a>
    </div>
  </div>
</div>

<script type="application/json" id="search-index" set:html={JSON.stringify(searchIndex)} />

<script>
  const searchIndex = JSON.parse(document.getElementById("search-index")!.textContent || "[]") as {
    title: string;
    slug: string;
  }[];

  const header = document.getElementById("page-header")!;
  const menuSearch = document.getElementById("menu-search")!;
  const menuNav = document.getElementById("menu-nav")!;
  const searchInput = document.getElementById("search-input") as HTMLInputElement;
  const autoCompleteList = document.getElementById("auto-complete-list")!;

  function openMenu(menu: HTMLElement) {
    menu.dataset.open = "true";
    document.body.classList.add("noscroll");
  }
  function closeMenu(menu: HTMLElement) {
    menu.dataset.open = "false";
    document.body.classList.remove("noscroll");
  }

  document.getElementById("open-search")?.addEventListener("click", () => {
    openMenu(menuSearch);
    searchInput.value = "";
    autoCompleteList.innerHTML = "";
    searchInput.focus();
  });
  document.getElementById("close-search")?.addEventListener("click", () => closeMenu(menuSearch));
  menuSearch.addEventListener("click", (e) => {
    if (e.target === menuSearch) closeMenu(menuSearch);
  });

  document.getElementById("open-nav")?.addEventListener("click", () => openMenu(menuNav));
  document.getElementById("close-nav")?.addEventListener("click", () => closeMenu(menuNav));
  menuNav.addEventListener("click", (e) => {
    if (e.target === menuNav) closeMenu(menuNav);
  });

  searchInput?.addEventListener("input", () => {
    const q = searchInput.value.trim().toLowerCase();
    autoCompleteList.innerHTML = "";
    if (!q) return;
    const matches = searchIndex.filter((p) => p.title.toLowerCase().includes(q)).slice(0, 10);
    matches.forEach((post) => {
      const a = document.createElement("a");
      a.className =
        "flex h-16 items-center justify-center text-primary-text hover:underline underline-offset-4 [&_p]:w-full [&_p]:text-center [&_p]:text-2xl";
      a.href = post.slug;
      const p = document.createElement("p");
      p.textContent = post.title;
      a.appendChild(p);
      autoCompleteList.appendChild(a);
    });
  });

  // hide header on scroll down, show on scroll up
  let lastScrollY = window.scrollY;
  let direction = 0;
  const THRESHOLD = 5;
  window.addEventListener("scroll", () => {
    const scrollY = window.scrollY;
    const windowHeight = window.innerHeight;
    const documentHeight = document.body.scrollHeight;
    if (scrollY <= 0 || scrollY + windowHeight >= documentHeight) {
      direction = 0;
    } else {
      const newDirection = scrollY > lastScrollY ? 1 : -1;
      if (newDirection !== direction && Math.abs(scrollY - lastScrollY) >= THRESHOLD) {
        direction = newDirection;
      }
    }
    lastScrollY = scrollY;
    header.dataset.hidden = String(direction === 1);
  });
</script>
