---
import AuthorIcon from "./icons/AuthorIcon.astro";
import SearchIcon from "./icons/SearchIcon.astro";
import MenuIcon from "./icons/MenuIcon.astro";
import CloseIcon from "./icons/CloseIcon.astro";
import { getAllPosts, getUniqueCategories } from "../utils/posts";

const posts = await getAllPosts();
const categories = ["All", ...getUniqueCategories(posts)];
const searchIndex = posts.map((p) => ({ title: p.data.title, slug: `/${p.slug}/` }));
---

<header class="page-header-wrapper" id="page-header">
  <div class="page-header">
    <div class="buttons">
      <button class="button button-logo" type="button" onclick="location.href='/'">
        <div class="logo"><AuthorIcon /></div>
      </button>
    </div>
    <div class="buttons right">
      <button class="button search" type="button" id="open-search" aria-label="Search">
        <div class="icon"><SearchIcon /></div>
      </button>
      <button class="button category" type="button" id="open-nav" aria-label="Menu">
        <div class="icon"><MenuIcon /></div>
      </button>
    </div>
  </div>
</header>

<div class="menu search" id="menu-search" data-open="false">
  <button class="button close" type="button" id="close-search" aria-label="Close">
    <div class="icon"><CloseIcon /></div>
  </button>
  <div class="search-wrapper">
    <div class="search-box">
      <div class="icon icon-search"><SearchIcon /></div>
      <input class="search-input" id="search-input" type="text" autocomplete="off" />
    </div>
    <div class="auto-complete-list" id="auto-complete-list"></div>
  </div>
</div>

<div class="menu nav" id="menu-nav" data-open="false">
  <button class="button close" type="button" id="close-nav" aria-label="Close">
    <div class="icon"><CloseIcon /></div>
  </button>
  <div class="nav-wrapper">
    <div class="nav-list">
      {categories.map((category, idx) => (
        <a class="nav-item" href={idx === 0 ? "/posts" : `/posts/${category}`}>
          <p>{category}</p>
        </a>
      ))}
      <a class="nav-item" href="/about">
        <p>About</p>
      </a>
    </div>
  </div>
</div>

<script type="application/json" id="search-index" set:html={JSON.stringify(searchIndex)} />

<script>
  const searchIndex = JSON.parse(document.getElementById("search-index")!.textContent || "[]") as {
    title: string;
    slug: string;
  }[];

  const header = document.getElementById("page-header")!;
  const menuSearch = document.getElementById("menu-search")!;
  const menuNav = document.getElementById("menu-nav")!;
  const searchInput = document.getElementById("search-input") as HTMLInputElement;
  const autoCompleteList = document.getElementById("auto-complete-list")!;

  function openMenu(menu: HTMLElement) {
    menu.dataset.open = "true";
    document.body.classList.add("noscroll");
  }
  function closeMenu(menu: HTMLElement) {
    menu.dataset.open = "false";
    document.body.classList.remove("noscroll");
  }

  document.getElementById("open-search")?.addEventListener("click", () => {
    openMenu(menuSearch);
    searchInput.value = "";
    autoCompleteList.innerHTML = "";
    searchInput.focus();
  });
  document.getElementById("close-search")?.addEventListener("click", () => closeMenu(menuSearch));
  menuSearch.addEventListener("click", (e) => {
    if (e.target === menuSearch) closeMenu(menuSearch);
  });

  document.getElementById("open-nav")?.addEventListener("click", () => openMenu(menuNav));
  document.getElementById("close-nav")?.addEventListener("click", () => closeMenu(menuNav));
  menuNav.addEventListener("click", (e) => {
    if (e.target === menuNav) closeMenu(menuNav);
  });

  searchInput?.addEventListener("input", () => {
    const q = searchInput.value.trim().toLowerCase();
    autoCompleteList.innerHTML = "";
    if (!q) return;
    const matches = searchIndex.filter((p) => p.title.toLowerCase().includes(q)).slice(0, 10);
    matches.forEach((post) => {
      const a = document.createElement("a");
      a.className = "auto-complete-item";
      a.href = post.slug;
      const p = document.createElement("p");
      p.textContent = post.title;
      a.appendChild(p);
      autoCompleteList.appendChild(a);
    });
  });

  // hide header on scroll down, show on scroll up
  let lastScrollY = window.scrollY;
  let direction = 0;
  const THRESHOLD = 5;
  window.addEventListener("scroll", () => {
    const scrollY = window.scrollY;
    const windowHeight = window.innerHeight;
    const documentHeight = document.body.scrollHeight;
    if (scrollY <= 0 || scrollY + windowHeight >= documentHeight) {
      direction = 0;
    } else {
      const newDirection = scrollY > lastScrollY ? 1 : -1;
      if (newDirection !== direction && Math.abs(scrollY - lastScrollY) >= THRESHOLD) {
        direction = newDirection;
      }
    }
    lastScrollY = scrollY;
    header.dataset.hidden = String(direction === 1);
  });
</script>

<style lang="scss">
  @use "../styles/mixins" as *;
  @use "../styles/variables" as *;

  .page-header-wrapper {
    z-index: 10;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;

    display: flex;
    padding: 1rem;

    pointer-events: none;

    .page-header {
      pointer-events: auto;
      width: 100%;

      display: flex;
      align-items: center;
      height: 3rem;

      .buttons {
        display: flex;
        .button + .button {
          margin-left: 0.5rem;
        }
        .button.button-logo {
          padding: 0.25rem;
          background: none;
          border: none;

          .logo {
            height: 2.5rem;
            width: 2.5rem;
            background-color: var(--brand-color);
            display: flex;
            align-items: center;
            justify-content: center;
            :global(svg) {
              width: 2.5rem;
              height: 2.5rem;
              fill: var(--background-color);
            }
          }
          @media (prefers-color-scheme: dark) {
            .logo {
              background-color: var(--background-color);
              :global(svg) {
                border: 1px solid var(--primary-text-color);
                fill: var(--primary-text-color);
              }
            }
          }
        }
        .button {
          background: none;
          border: none;
        }
      }

      .right {
        margin-left: auto !important;
      }
    }

    transition: top 0.25s ease;
    &[data-hidden="true"] {
      top: -5rem;
    }

    .icon {
      height: 3rem;
      width: 3rem;
      display: flex;
      align-items: center;
      justify-content: center;
      :global(svg) {
        height: 1.75rem;
        width: 1.75rem;
        fill: var(--primary-text-color);
      }
    }
  }

  .menu {
    z-index: 20;
    position: fixed;
    top: 0;
    bottom: 0;
    left: 0;
    right: 0;

    pointer-events: none;
    background-color: transparent;
    transition: background-color 0.5s ease;

    & > * {
      opacity: 0;
      transition: opacity 0.5s ease;
    }

    &[data-open="true"] {
      pointer-events: auto;
      -webkit-backdrop-filter: blur(1rem);
      backdrop-filter: blur(1rem);
      background-color: var(--float-background-color);
      & > * {
        opacity: 1;
      }
    }

    & > .button.close {
      position: absolute;
      top: 1rem;
      right: 1rem;
      background: none;
      border: none;
      z-index: 1;
    }

    .icon {
      height: 3rem;
      width: 3rem;
      display: flex;
      align-items: center;
      justify-content: center;
      :global(svg) {
        height: 1.75rem;
        width: 1.75rem;
        fill: var(--primary-text-color);
      }
    }
  }

  .menu.search {
    padding-top: 5rem;
    .search-wrapper {
      position: absolute;
      top: 5rem;
      bottom: 0;
      left: 1.5rem;
      right: 1.5rem;
      @include lg {
        left: 25%;
        right: 25%;
      }

      .search-box {
        display: flex;
        justify-content: center;
        align-items: center;

        height: 4rem;
        border-bottom: 0.1875rem solid var(--primary-text-color);

        position: relative;
        .icon.icon-search {
          position: absolute;
          left: 0;
          height: 100%;
          width: auto;
          margin-right: 0.75rem;
        }
        .search-input {
          font-size: 1.5rem;
          height: 100%;
          width: calc(100% - 3rem - 2rem);
          text-align: center;
          background: none;
          border: none;
          color: var(--primary-text-color);
          outline: none;
        }
      }
      .auto-complete-list {
        padding-top: 2rem;

        display: flex;
        flex-direction: column;

        .auto-complete-item {
          height: 4rem;
          display: flex;
          align-items: center;
          color: var(--primary-text-color);

          p {
            width: 100%;
            font-size: 1.5rem;
            text-align: center;
          }
        }
      }
    }
  }

  .menu.nav {
    .nav-wrapper {
      position: absolute;
      top: 5rem;
      bottom: 0;
      left: 1.5rem;
      right: 1.5rem;
      @include lg {
        left: 25%;
        right: 25%;
      }

      .nav-list {
        display: flex;
        flex-direction: column;

        .nav-item {
          height: 4rem;
          display: flex;
          align-items: center;
          color: var(--primary-text-color);

          p {
            width: 100%;
            font-size: 1.5rem;
            text-align: center;
          }
        }
      }
    }
  }
</style>
