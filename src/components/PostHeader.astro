---
import { formatDate } from "../utils/posts";
import type { Post } from "../utils/posts";

interface Props {
  post: Post;
}
const { post } = Astro.props;
---

<header class="post-header grid">
  <h1 class="title grid-12">{post.data.title}</h1>
  <div class="info grid-34">{formatDate(post.data.date)}</div>
</header>

<style lang="scss">
  .post-header {
    align-items: center;
    width: 100%;

    padding-bottom: 6rem;
    word-break: keep-all;

    .title {
      font-size: 2rem;
      line-height: 1.3;
      color: var(--primary-text-color);
      margin-bottom: 0.5rem;
    }

    .info {
      font-size: 1.5rem;
      line-height: 1.3;
      color: var(--primary-text-color);
      margin-bottom: 0.5rem;
    }
  }
</style>
