---
import Layout from "@/layouts/Layout.astro";
import PostListSection from "@/components/PostListSection.astro";
import { getAllPosts, getUniqueCategories } from "@/utils/posts";

const posts = await getAllPosts();
const categories = ["All", ...getUniqueCategories(posts)];
const featuredIndex = categories.findIndex((c) => c === "featured");
const categoryIndex = featuredIndex === -1 ? 0 : featuredIndex;
const categoryTitle = categories[categoryIndex];
const categoryPosts =
  categoryTitle === "All" ? posts : posts.filter((p) => p.data.categories.includes(categoryTitle));
---

<Layout>
  <PostListSection title={categoryTitle} posts={categoryPosts} />
</Layout>
