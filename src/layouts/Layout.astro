---
import PageHeader from "@/components/PageHeader.astro";
import PageFooter from "@/components/PageFooter.astro";
import { SITE } from "@/utils/site";
import "@fontsource/gothic-a1/300.css";
import "@fontsource/gothic-a1/600.css";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  lang?: string;
  showHomeLink?: boolean;
}
const { title, description, lang, showHomeLink } = Astro.props;
const pageTitle = title ?? SITE.title;
const metaDescription = description || SITE.description;
const ogImage = new URL("/brand/og-image.jpg", Astro.site).toString();
---

<!doctype html>
<html lang={lang ?? SITE.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/brand/logo.svg" />
    <title>{pageTitle}</title>
    {metaDescription && <meta name="description" content={metaDescription} />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:site_name" content={SITE.title} />
    {metaDescription && (
      <meta property="og:description" content={metaDescription} />
    )}
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="website" />
    <script
      async
      src={`https://www.googletagmanager.com/gtag/js?id=G-E868R1LME4`}></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-E868R1LME4");
    </script>
  </head>
  <body>
    <div class="relative flex min-h-screen w-full flex-col items-center px-6 pt-32 pb-32 text-primary-text lg:px-12">
      <PageHeader showHomeLink={showHomeLink} />
      <main class="flex h-full w-full flex-col items-center">
        <slot />
      </main>
      <PageFooter author={SITE.author} githubUrl={SITE.social.github} />
    </div>
  </body>
</html>
